# Server-only secrets. Never prefix these with VITE_ and never commit real values.
# FAHIM routes across configured providers in order and fails over without exposing provider/model names to clients.
AI_PROVIDER_ORDER=agent-router,gemini
AGENT_ROUTER_API_KEY=replace_in_vercel_dashboard
AGENT_ROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENT_ROUTER_MODEL=glm-5.1
AGENT_ROUTER_FALLBACK_MODEL=
AGENT_ROUTER_INPUT_USD_PER_MILLION_TOKENS=replace_with_current_model_rate
AGENT_ROUTER_OUTPUT_USD_PER_MILLION_TOKENS=replace_with_current_model_rate
GEMINI_API_KEY=replace_in_vercel_dashboard
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_INPUT_USD_PER_MILLION_TOKENS=replace_with_current_model_rate
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=replace_with_current_model_rate
YOUTUBE_API_KEY=replace_with_a_restricted_youtube_data_api_key
QUIZ_TOKEN_SECRET=generate_a_random_32_byte_or_longer_server_secret
PUBLIC_SITE_URL=https://your-production-domain.example

# Public Supabase browser configuration. These are not service-role secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_your_anon_key

# Server-side Supabase configuration. SERVICE_ROLE must never use a VITE_ prefix.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_only_in_the_server_environment

# Supabase Edge Function browser origins, comma-separated.
FAHIM_ALLOWED_ORIGINS=https://your-production-domain.example
